# WebLens backend configuration. Copy to .env and adjust.
# Every setting is optional; defaults are defined in src/weblens/config.py.

# --- Server ---
WEBLENS_HOST=127.0.0.1
WEBLENS_PORT=8000
WEBLENS_DEBUG=false
# Comma-separated exact origins allowed to call the API.
WEBLENS_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# --- Logging ---
# text | json
WEBLENS_LOG_FORMAT=text
WEBLENS_LOG_LEVEL=INFO

# --- Scan budgets ---
WEBLENS_NAVIGATION_TIMEOUT_MS=30000
WEBLENS_SETTLE_TIMEOUT_MS=5000
WEBLENS_TOTAL_SCAN_BUDGET_MS=90000
WEBLENS_HTTP_TIMEOUT_MS=15000

# --- Politeness / concurrency ---
WEBLENS_MAX_CONCURRENT_SCANS=2
WEBLENS_MAX_CONCURRENT_SCANS_PER_HOST=1
WEBLENS_MIN_HOST_INTERVAL_SECONDS=5
WEBLENS_RESPECT_ROBOTS=true
WEBLENS_MAX_REDIRECTS=5
# One extra HEAD request per scan to observe whether http:// redirects to https://.
WEBLENS_PROBE_HTTP_DOWNGRADE=true

# --- Evidence caps ---
WEBLENS_MAX_BODY_BYTES=2097152
WEBLENS_MAX_NETWORK_REQUESTS_RECORDED=400
WEBLENS_MAX_STYLE_SAMPLES=1500

# --- Result buffer (the browser is the system of record) ---
WEBLENS_RESULT_TTL_SECONDS=900
WEBLENS_MAX_RETAINED_RESULTS=25

# --- Target guard ---
# Extra ports allowed in addition to 80/443. Comma-separated.
WEBLENS_ALLOWED_EXTRA_PORTS=[]
# TEST ONLY. Allows scanning loopback/private addresses. Never enable on a shared machine.
WEBLENS_ALLOW_PRIVATE_TARGETS=false

# --- Optional AI explanation layer (disabled by default) ---
WEBLENS_AI_PROVIDER=none
